# Normalise line endings in the repository to LF, whichever platform or tool touched the file,
# so a diff shows the change and nothing else.
* text=auto eol=lf

# Binary: never touch these.
*.parquet binary
*.duckdb  binary
*.gz      binary
*.png     binary

# Notebooks: outputs are stripped on commit, so the diff shows code (see pyproject figures).
*.ipynb filter=nbstripout
*.ipynb diff=ipynb
